{
  "name": "GiftCardTransaction",
  "type": "object",
  "properties": {
    "gift_card_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0647\u062f\u0627\u064a\u0627"
    },
    "gift_card_code": {
      "type": "string",
      "title": "\u0643\u0648\u062f \u0627\u0644\u0628\u0637\u0627\u0642\u0629"
    },
    "order_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0637\u0644\u0628"
    },
    "order_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0637\u0644\u0628"
    },
    "amount": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a"
    },
    "balance_before": {
      "type": "number",
      "title": "\u0627\u0644\u0631\u0635\u064a\u062f \u0642\u0628\u0644"
    },
    "balance_after": {
      "type": "number",
      "title": "\u0627\u0644\u0631\u0635\u064a\u062f \u0628\u0639\u062f"
    },
    "type": {
      "type": "string",
      "enum": [
        "purchase",
        "refund",
        "adjustment"
      ],
      "title": "\u0646\u0648\u0639 \u0627\u0644\u062d\u0631\u0643\u0629",
      "default": "purchase"
    },
    "idempotency_key": {
      "type": "string",
      "title": "\u0645\u0641\u062a\u0627\u062d \u0645\u0646\u0639 \u0627\u0644\u062a\u0643\u0631\u0627\u0631"
    }
  },
  "required": [
    "gift_card_id",
    "amount"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}