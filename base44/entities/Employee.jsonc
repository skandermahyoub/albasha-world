{
  "name": "Employee",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "email": {
      "type": "string",
      "title": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "phone": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "role": {
      "type": "string",
      "title": "\u0627\u0644\u062f\u0648\u0631",
      "enum": [
        "manager",
        "sales",
        "support",
        "warehouse"
      ],
      "default": "sales"
    },
    "store_key": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u062a\u062c\u0631 \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0639\u0646\u0647",
      "enum": [
        "perfume",
        "vape",
        "shisha",
        "pets",
        "boutique",
        "all"
      ]
    },
    "is_active": {
      "type": "boolean",
      "title": "\u0645\u0641\u0639\u0651\u0644",
      "default": true
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "name",
    "role"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}