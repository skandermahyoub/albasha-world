{
  "name": "CashierShift",
  "type": "object",
  "properties": {
    "shift_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0648\u0631\u062f\u064a\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "default": "open"
    },
    "opened_at": {
      "type": "string",
      "title": "\u0648\u0642\u062a \u0627\u0644\u0641\u062a\u062d"
    },
    "closed_at": {
      "type": "string",
      "title": "\u0648\u0642\u062a \u0627\u0644\u0625\u063a\u0644\u0627\u0642"
    },
    "opening_cash": {
      "type": "number",
      "title": "\u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0639\u0646\u062f \u0627\u0644\u0641\u062a\u062d",
      "default": 0
    },
    "closing_cash": {
      "type": "number",
      "title": "\u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0639\u0646\u062f \u0627\u0644\u0625\u063a\u0644\u0627\u0642",
      "default": 0
    },
    "total_sales": {
      "type": "number",
      "title": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a",
      "default": 0
    },
    "orders_count": {
      "type": "number",
      "title": "\u0639\u062f\u062f \u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631",
      "default": 0
    },
    "returns_total": {
      "type": "number",
      "title": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a",
      "default": 0
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "shift_number",
    "status",
    "opened_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}