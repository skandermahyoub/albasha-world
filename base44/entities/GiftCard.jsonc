{
  "name": "GiftCard",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "title": "\u0643\u0648\u062f \u0627\u0644\u0628\u0637\u0627\u0642\u0629"
    },
    "amount": {
      "type": "number",
      "title": "\u0627\u0644\u0642\u064a\u0645\u0629"
    },
    "currency": {
      "type": "string",
      "title": "\u0627\u0644\u0639\u0645\u0644\u0629",
      "default": "USD"
    },
    "used_amount": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645",
      "default": 0
    },
    "issued_to_email": {
      "type": "string",
      "title": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u062a\u0644\u0645"
    },
    "issued_by_email": {
      "type": "string",
      "title": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0631\u0633\u0644"
    },
    "message": {
      "type": "string",
      "title": "\u0631\u0633\u0627\u0644\u0629 \u0645\u0631\u0641\u0642\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "used",
        "expired"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "default": "active"
    },
    "expires_at": {
      "type": "string",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621"
    }
  },
  "required": [
    "code",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}