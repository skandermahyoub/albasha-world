{
  "name": "SystemTransaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0639\u0645\u0644\u064a\u0629",
      "enum": [
        "order_profit",
        "deposit",
        "withdrawal",
        "order_return"
      ],
      "default": "order_profit"
    },
    "amount": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a"
    },
    "order_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0637\u0644\u0628"
    },
    "order_subtotal": {
      "type": "number",
      "title": "\u0642\u064a\u0645\u0629 \u0627\u0644\u0637\u0644\u0628 \u0642\u0628\u0644 \u0627\u0644\u062e\u0635\u0645"
    },
    "order_discount": {
      "type": "number",
      "title": "\u0642\u064a\u0645\u0629 \u0627\u0644\u062e\u0635\u0645"
    },
    "performed_by": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0646\u0641\u0630"
    },
    "reason": {
      "type": "string",
      "title": "\u0633\u0628\u0628 \u0627\u0644\u0639\u0645\u0644\u064a\u0629"
    },
    "date": {
      "type": "string",
      "title": "\u0627\u0644\u062a\u0627\u0631\u064a\u062e"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "reference_transaction_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0642\u064a\u062f \u0627\u0644\u0645\u0631\u062a\u0628\u0637"
    },
    "is_test": {
      "type": "boolean",
      "title": "\u0642\u064a\u062f \u0627\u062e\u062a\u0628\u0627\u0631\u064a \u0645\u0624\u0631\u0634\u0641",
      "default": false,
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "type",
    "amount"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}