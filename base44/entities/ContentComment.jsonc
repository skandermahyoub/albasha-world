{
  "name": "ContentComment",
  "type": "object",
  "properties": {
    "content_type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0645\u062d\u062a\u0648\u0649",
      "enum": [
        "app",
        "product",
        "blog",
        "video"
      ]
    },
    "content_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u062d\u062a\u0648\u0649"
    },
    "name": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645"
    },
    "comment": {
      "type": "string",
      "title": "\u0627\u0644\u062a\u0639\u0644\u064a\u0642"
    },
    "visitor_key": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0632\u0627\u0626\u0631",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "enum": [
        "approved",
        "pending",
        "hidden"
      ],
      "default": "pending"
    }
  },
  "required": [
    "content_type",
    "content_id",
    "name",
    "comment"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}