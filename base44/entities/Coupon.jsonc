{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "title": "\u0643\u0648\u062f \u0627\u0644\u062e\u0635\u0645"
    },
    "store_key": {
      "type": "string",
      "enum": [
        "shisha",
        "vape",
        "boutique",
        "perfume",
        "pets"
      ],
      "title": "\u0627\u0644\u0642\u0633\u0645"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ],
      "title": "\u0646\u0648\u0639 \u0627\u0644\u062e\u0635\u0645",
      "default": "percentage"
    },
    "discount_value": {
      "type": "number",
      "title": "\u0642\u064a\u0645\u0629 \u0627\u0644\u062e\u0635\u0645"
    },
    "min_order_value": {
      "type": "number",
      "title": "\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u062f\u0646\u0649 \u0644\u0644\u0637\u0644\u0628",
      "default": 0
    },
    "max_uses": {
      "type": "number",
      "title": "\u0623\u0642\u0635\u0649 \u0639\u062f\u062f \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0627\u062a",
      "default": 0
    },
    "used_count": {
      "type": "number",
      "title": "\u0645\u0631\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645",
      "default": 0
    },
    "valid_from": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0628\u062f\u0627\u064a\u0629"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621"
    },
    "is_active": {
      "type": "boolean",
      "title": "\u0645\u0641\u0639\u0651\u0644",
      "default": true
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641"
    },
    "source": {
      "type": "string",
      "enum": [
        "admin",
        "spin_wheel",
        "affiliate",
        "abandoned_cart"
      ],
      "title": "\u0627\u0644\u0645\u0635\u062f\u0631",
      "default": "admin"
    }
  },
  "required": [
    "code",
    "store_key",
    "discount_type",
    "discount_value"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}