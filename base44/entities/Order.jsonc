{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0637\u0644\u0628"
    },
    "customer_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "customer_phone": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "customer_email": {
      "type": "string",
      "title": "\u0627\u0644\u0628\u0631\u064a\u062f"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "cost_price": {
            "type": "number",
            "rls": {
              "read": {
                "user_condition": {
                  "role": "admin"
                }
              }
            }
          },
          "store_key": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "image": {
            "type": "string"
          }
        }
      },
      "title": "\u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a"
    },
    "subtotal": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0641\u0631\u0639\u064a"
    },
    "discount": {
      "type": "number",
      "title": "\u0627\u0644\u062e\u0635\u0645"
    },
    "total": {
      "type": "number",
      "title": "\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a"
    },
    "amount_due": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062a\u0628\u0642\u064a \u0628\u0639\u062f \u0627\u0644\u0645\u062d\u0641\u0638\u0629",
      "default": 0
    },
    "currency": {
      "type": "string",
      "title": "\u0627\u0644\u0639\u0645\u0644\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "preparing",
        "shipped",
        "delivered",
        "cancelled",
        "returned"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      },
      "title": "\u0633\u062c\u0644 \u0627\u0644\u062d\u0627\u0644\u0627\u062a"
    },
    "payment_method": {
      "type": "string",
      "title": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "address": {
      "type": "string",
      "title": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646"
    },
    "shipping_zone": {
      "type": "string",
      "title": "\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0634\u062d\u0646"
    },
    "shipping_fee": {
      "type": "number",
      "title": "\u0631\u0633\u0648\u0645 \u0627\u0644\u0634\u062d\u0646",
      "default": 0
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "expected_delivery": {
      "type": "string",
      "format": "date",
      "title": "\u0627\u0644\u062a\u0633\u0644\u064a\u0645 \u0627\u0644\u0645\u062a\u0648\u0642\u0639"
    },
    "delivery_rating": {
      "type": "number",
      "title": "\u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u062a\u0648\u0635\u064a\u0644",
      "minimum": 1,
      "maximum": 5
    },
    "shift_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0648\u0631\u062f\u064a\u0629"
    },
    "source": {
      "type": "string",
      "title": "\u0645\u0635\u062f\u0631 \u0627\u0644\u0637\u0644\u0628",
      "default": "online"
    },
    "assigned_employee": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u062d\u062c\u0648\u0632 \u0644\u0647"
    },
    "loyalty_points_earned": {
      "type": "number",
      "title": "\u0646\u0642\u0627\u0637 \u0627\u0644\u0648\u0644\u0627\u0621 \u0627\u0644\u0645\u0643\u062a\u0633\u0628\u0629",
      "default": 0
    },
    "loyalty_points_spent": {
      "type": "number",
      "title": "\u0646\u0642\u0627\u0637 \u0627\u0644\u0648\u0644\u0627\u0621 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0629",
      "default": 0
    },
    "wallet_used": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062e\u0635\u0648\u0645 \u0645\u0646 \u0627\u0644\u0645\u062d\u0641\u0638\u0629",
      "default": 0
    },
    "coupon_code": {
      "type": "string",
      "title": "\u0643\u0648\u062f \u0627\u0644\u0643\u0648\u0628\u0648\u0646"
    },
    "gift_card_code": {
      "type": "string",
      "title": "\u0643\u0648\u062f \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0647\u062f\u064a\u0629"
    },
    "customer_metrics_updated": {
      "type": "boolean",
      "title": "\u062a\u0645 \u062a\u062d\u062f\u064a\u062b \u0625\u062d\u0635\u0627\u0621\u0627\u062a \u0627\u0644\u0639\u0645\u064a\u0644",
      "default": false
    },
    "financial_reversed": {
      "type": "boolean",
      "title": "\u062a\u0645 \u0639\u0643\u0633 \u0627\u0644\u062a\u0633\u0648\u064a\u0627\u062a \u0627\u0644\u0645\u0627\u0644\u064a\u0629",
      "default": false
    },
    "idempotency_key": {
      "type": "string",
      "title": "\u0645\u0641\u062a\u0627\u062d \u0645\u0646\u0639 \u0627\u0644\u062a\u0643\u0631\u0627\u0631"
    },
    "stock_deducted": {
      "type": "boolean",
      "title": "\u062a\u0645 \u062e\u0635\u0645 \u0627\u0644\u0645\u062e\u0632\u0648\u0646",
      "default": false
    },
    "sales_updated": {
      "type": "boolean",
      "title": "\u062a\u0645 \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a",
      "default": false
    },
    "commission_calculated": {
      "type": "boolean",
      "title": "\u062a\u0645 \u0627\u062d\u062a\u0633\u0627\u0628 \u0627\u0644\u0639\u0645\u0648\u0644\u0629",
      "default": false
    },
    "return_processed": {
      "type": "boolean",
      "title": "\u062a\u0645 \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0645\u0631\u062a\u062c\u0639",
      "default": false
    }
  },
  "required": [
    "customer_name",
    "customer_phone",
    "items",
    "total"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}