{
  "name": "LoyaltyRewardClaim",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "title": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "event_key": {
      "type": "string",
      "title": "\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u062d\u062f\u062b"
    },
    "action": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0643\u0627\u0641\u0623\u0629"
    },
    "points": {
      "type": "number",
      "title": "\u0627\u0644\u0646\u0642\u0627\u0637"
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641"
    }
  },
  "required": [
    "user_email",
    "event_key",
    "action",
    "points"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}