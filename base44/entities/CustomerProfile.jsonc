{
  "name": "CustomerProfile",
  "type": "object",
  "properties": {
    "customer_number": {
      "type": "number",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u062a\u0633\u0644\u0633\u0644\u064a \u0644\u0644\u0639\u0645\u064a\u0644",
      "default": 0
    },
    "user_email": {
      "type": "string",
      "title": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "name": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645"
    },
    "full_name": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0631\u0628\u0627\u0639\u064a"
    },
    "id_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0648\u064a\u0629"
    },
    "profile_photo": {
      "type": "string",
      "title": "\u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0634\u062e\u0635\u064a\u0629"
    },
    "address": {
      "type": "string",
      "title": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646"
    },
    "phone": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "tier": {
      "type": "string",
      "title": "\u062f\u0631\u062c\u0629 \u0627\u0644\u0639\u0636\u0648\u064a\u0629",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum",
        "vip"
      ],
      "default": "bronze"
    },
    "admin_rating": {
      "type": "string",
      "title": "\u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0625\u062f\u0627\u0631\u0629",
      "enum": [
        "excellent",
        "good",
        "bad"
      ],
      "default": "good"
    },
    "total_spent": {
      "type": "number",
      "title": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0625\u0646\u0641\u0627\u0642",
      "default": 0
    },
    "orders_count": {
      "type": "number",
      "title": "\u0639\u062f\u062f \u0627\u0644\u0637\u0644\u0628\u0627\u062a",
      "default": 0
    },
    "wallet_balance": {
      "type": "number",
      "title": "\u0631\u0635\u064a\u062f \u0627\u0644\u0645\u062d\u0641\u0638\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629",
      "default": 0
    },
    "affiliate_code": {
      "type": "string",
      "title": "\u0643\u0648\u062f \u0627\u0644\u062a\u0633\u0648\u064a\u0642 \u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0629"
    },
    "is_affiliate": {
      "type": "boolean",
      "title": "\u0645\u0633\u062c\u0651\u0644 \u0643\u0645\u0633\u064a\u0648\u0651\u0642",
      "default": false
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0648\u0633\u0648\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "preferred_store": {
      "type": "string",
      "title": "\u0627\u0644\u0642\u0633\u0645 \u0627\u0644\u0645\u0641\u0636\u0644",
      "enum": [
        "shisha",
        "boutique",
        "perfume",
        "vape",
        "pets"
      ]
    },
    "last_interaction": {
      "type": "string",
      "title": "\u0622\u062e\u0631 \u062a\u0641\u0627\u0639\u0644"
    },
    "interaction_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "title": "\u0633\u062c\u0644 \u0627\u0644\u062a\u0641\u0627\u0639\u0644\u0627\u062a"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}