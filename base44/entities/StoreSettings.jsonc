    "age_gate_message": {
      "type": "string",
      "title": "\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0639\u0645\u0631",
      "default": "\u064a\u062d\u062a\u0648\u064a \u0627\u0644\u0645\u062a\u062c\u0631 \u0639\u0644\u0649 \u0645\u0646\u062a\u062c\u0627\u062a \u0645\u062e\u0635\u0635\u0629 \u0644\u0644\u0628\u0627\u0644\u063a\u064a\u0646. \u064a\u0631\u062c\u0649 \u062a\u0623\u0643\u064a\u062f \u0628\u0644\u0648\u063a\u0643 \u0627\u0644\u0633\u0646 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a \u0642\u0628\u0644 \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629."
    },
    "footer_about": {
      "type": "string",
      "title": "\u0646\u0628\u0630\u0629 \u0627\u0644\u0641\u0648\u062a\u0631",
      "default": "\u0639\u0627\u0644\u0645 \u0627\u0644\u0628\u0627\u0634\u0627 \u0644\u0644\u062a\u0633\u0648\u0642 \u0648\u062c\u0647\u062a\u0643 \u0627\u0644\u0623\u0648\u0644\u0649 \u0644\u0643\u0644 \u0645\u0627 \u062a\u0628\u062d\u062b \u0639\u0646\u0647 \u0645\u0646 \u0645\u0639\u0633\u0644\u0627\u062a \u0634\u064a\u0634\u0629 \u0648\u0641\u062d\u0645 \u0648\u0642\u0635\u062f\u064a\u0631 \u0648\u0645\u0633\u062a\u0644\u0632\u0645\u0627\u062a \u0627\u0644\u062a\u062f\u062e\u064a\u0646\u060c \u0648\u0647\u062f\u0627\u064a\u0627 \u0648\u062a\u062d\u0641 \u0648\u0632\u0647\u0648\u0631\u060c \u0648\u0639\u0637\u0648\u0631 \u0641\u0627\u062e\u0631\u0629\u060c \u0648\u0623\u062c\u0647\u0632\u0629 \u0641\u064a\u0628 \u0648\u0646\u0643\u0647\u0627\u062a \u0648\u0648\u0633\u0627\u0626\u0644 \u0648\u0642\u0637\u0639 \u063a\u064a\u0627\u0631 \u0648\u0633\u062d\u0628\u0627\u062a \u062c\u0627\u0647\u0632\u0629\u060c \u0648\u0637\u0639\u0627\u0645 \u0644\u0644\u062d\u064a\u0648\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0644\u064a\u0641\u0629 \u0648\u0627\u0644\u0637\u064a\u0648\u0631. \u0646\u0642\u062f\u0645 \u0645\u0646\u062a\u062c\u0627\u062a \u0623\u0635\u0644\u064a\u0629 \u0628\u0623\u0633\u0639\u0627\u0631 \u062a\u0646\u0627\u0641\u0633\u064a\u0629 \u0648\u062e\u062f\u0645\u0629 \u0631\u0627\u0642\u064a\u0629."
