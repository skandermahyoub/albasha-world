    "slogan": {
      "type": "string",
      "title": "\u0627\u0644\u0634\u0639\u0627\u0631 \u0627\u0644\u0646\u0635\u064a",
      "default": "\u0639\u0627\u0644\u0645\u0643 \u0627\u0644\u0645\u062a\u0643\u0627\u0645\u0644 \u0644\u0644\u0634\u064a\u0634\u0629 \u0648\u0627\u0644\u0628\u0648\u062a\u064a\u0643 \u0648\u0627\u0644\u0639\u0637\u0648\u0631 \u0648\u0627\u0644\u0641\u064a\u0628 \u0648\u0645\u0633\u062a\u0644\u0632\u0645\u0627\u062a \u0627\u0644\u062d\u064a\u0648\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0644\u064a\u0641\u0629"
