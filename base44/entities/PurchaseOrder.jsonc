{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "po_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0623\u0645\u0631 \u0627\u0644\u0634\u0631\u0627\u0621"
    },
    "supplier_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0648\u0631\u062f"
    },
    "supplier_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0631\u062f"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_cost": {
            "type": "number"
          },
          "total_cost": {
            "type": "number"
          }
        }
      },
      "title": "\u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a"
    },
    "total_cost": {
      "type": "number",
      "title": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u062a\u0643\u0644\u0641\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "confirmed",
        "received",
        "partial",
        "cancelled"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "default": "draft"
    },
    "auto_generated": {
      "type": "boolean",
      "title": "\u0645\u064f\u0646\u0634\u0623 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b (\u0646\u0642\u0635 \u0645\u062e\u0632\u0648\u0646)",
      "default": false
    },
    "sent_via": {
      "type": "string",
      "enum": [
        "whatsapp",
        "email",
        "manual"
      ],
      "title": "\u0623\u064f\u0631\u0633\u0644 \u0639\u0628\u0631"
    },
    "paid_amount": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062f\u0641\u0648\u0639",
      "default": 0
    },
    "remaining_amount": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062a\u0628\u0642\u064a",
      "default": 0
    },
    "expected_delivery": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0633\u0644\u064a\u0645 \u0627\u0644\u0645\u062a\u0648\u0642\u0639"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "po_number",
    "supplier_name",
    "items",
    "total_cost"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}