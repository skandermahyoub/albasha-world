{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "title": "\u0628\u0631\u064a\u062f \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "customer_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "customer_phone": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "product_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0646\u062a\u062c"
    },
    "product_title": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0646\u062a\u062c"
    },
    "product_image": {
      "type": "string",
      "title": "\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0646\u062a\u062c"
    },
    "quantity": {
      "type": "number",
      "title": "\u0627\u0644\u0643\u0645\u064a\u0629",
      "default": 1
    },
    "price": {
      "type": "number",
      "title": "\u0627\u0644\u0633\u0639\u0631 \u0628\u0639\u062f \u0627\u0644\u062e\u0635\u0645"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly",
        "monthly"
      ],
      "title": "\u0627\u0644\u062a\u0643\u0631\u0627\u0631",
      "default": "monthly"
    },
    "discount_percent": {
      "type": "number",
      "title": "\u0646\u0633\u0628\u0629 \u062e\u0635\u0645 \u0627\u0644\u0645\u0634\u062a\u0631\u0643",
      "default": 10
    },
    "next_delivery": {
      "type": "string",
      "title": "\u0645\u0648\u0639\u062f \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0642\u0627\u062f\u0645"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "cancelled"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "default": "active"
    }
  },
  "required": [
    "product_id",
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}