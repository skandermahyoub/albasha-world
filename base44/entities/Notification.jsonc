{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646"
    },
    "message": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0633\u0627\u0644\u0629"
    },
    "icon": {
      "type": "string",
      "title": "\u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0629",
      "default": "\ud83c\udf89"
    },
    "type": {
      "type": "string",
      "enum": [
        "promo",
        "info",
        "alert",
        "loyalty"
      ],
      "title": "\u0627\u0644\u0646\u0648\u0639",
      "default": "promo"
    },
    "customer_email": {
      "type": "string",
      "title": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u062a\u0644\u0645"
    },
    "target_type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u0645\u0631\u062a\u0628\u0637"
    },
    "target_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u0645\u0631\u062a\u0628\u0637"
    },
    "target_route": {
      "type": "string",
      "title": "\u0631\u0627\u0628\u0637 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u0645\u0631\u062a\u0628\u0637"
    },
    "is_read": {
      "type": "boolean",
      "title": "\u062a\u0645\u062a \u0627\u0644\u0642\u0631\u0627\u0621\u0629",
      "default": false
    },
    "read_at": {
      "type": "string",
      "title": "\u0648\u0642\u062a \u0627\u0644\u0642\u0631\u0627\u0621\u0629"
    },
    "event_key": {
      "type": "string",
      "title": "\u0645\u0641\u062a\u0627\u062d \u0645\u0646\u0639 \u0627\u0644\u062a\u0643\u0631\u0627\u0631"
    },
    "interval_minutes": {
      "type": "number",
      "title": "\u0643\u0644 \u0643\u0645 \u062f\u0642\u064a\u0642\u0629 \u064a\u0638\u0647\u0631",
      "default": 5
    },
    "sort_order": {
      "type": "number",
      "title": "\u0627\u0644\u062a\u0631\u062a\u064a\u0628",
      "default": 1
    },
    "is_active": {
      "type": "boolean",
      "title": "\u0645\u0641\u0639\u0651\u0644",
      "default": true
    }
  },
  "required": [
    "title",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}