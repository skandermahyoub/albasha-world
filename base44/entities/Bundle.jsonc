{
  "name": "Bundle",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0628\u0627\u0642\u0629"
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641"
    },
    "image": {
      "type": "string",
      "title": "\u0635\u0648\u0631\u0629 \u0627\u0644\u0628\u0627\u0642\u0629"
    },
    "product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a"
    },
    "original_price": {
      "type": "number",
      "title": "\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0623\u0635\u0644\u064a"
    },
    "bundle_price": {
      "type": "number",
      "title": "\u0633\u0639\u0631 \u0627\u0644\u0628\u0627\u0642\u0629"
    },
    "discount_percent": {
      "type": "number",
      "title": "\u0646\u0633\u0628\u0629 \u0627\u0644\u062e\u0635\u0645"
    },
    "is_active": {
      "type": "boolean",
      "title": "\u0645\u0641\u0639\u0644",
      "default": true
    },
    "show_on_home": {
      "type": "boolean",
      "title": "\u0639\u0631\u0636 \u0641\u064a \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629",
      "default": false
    }
  },
  "required": [
    "title",
    "bundle_price",
    "product_ids"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}