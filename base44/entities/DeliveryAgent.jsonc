{
  "name": "DeliveryAgent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0646\u062f\u0648\u0628"
    },
    "phone": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "email": {
      "type": "string",
      "title": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "busy",
        "offline"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "default": "offline"
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "car",
        "motorcycle",
        "bicycle",
        "van"
      ],
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0631\u0643\u0628\u0629",
      "default": "motorcycle"
    },
    "current_location_lat": {
      "type": "number",
      "title": "\u062e\u0637 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u062d\u0627\u0644\u064a"
    },
    "current_location_lng": {
      "type": "number",
      "title": "\u062e\u0637 \u0627\u0644\u0637\u0648\u0644 \u0627\u0644\u062d\u0627\u0644\u064a"
    },
    "assigned_orders": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u0633\u0646\u062f\u0629"
    },
    "completed_deliveries": {
      "type": "number",
      "title": "\u0627\u0644\u062a\u0648\u0635\u064a\u0644\u0627\u062a \u0627\u0644\u0645\u0643\u062a\u0645\u0644\u0629",
      "default": 0
    },
    "rating": {
      "type": "number",
      "title": "\u0627\u0644\u062a\u0642\u064a\u064a\u0645",
      "default": 5
    },
    "is_active": {
      "type": "boolean",
      "title": "\u0645\u0641\u0639\u0651\u0644",
      "default": true
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "name",
    "phone"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}