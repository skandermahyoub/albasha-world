{
  "name": "WishList",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "title": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0642\u0627\u0626\u0645\u0629"
    },
    "product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a"
    },
    "is_public": {
      "type": "boolean",
      "title": "\u0639\u0627\u0645\u0629",
      "default": false
    },
    "share_token": {
      "type": "string",
      "title": "\u0631\u0645\u0632 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629"
    }
  },
  "required": [
    "user_email",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}