{
  "name": "ShippingZone",
  "type": "object",
  "properties": {
    "zone_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 / \u0646\u0642\u0637\u0629 \u0627\u0644\u0648\u0635\u0648\u0644"
    },
    "delivery_fee": {
      "type": "number",
      "title": "\u0631\u0633\u0648\u0645 \u0627\u0644\u0634\u062d\u0646"
    },
    "currency": {
      "type": "string",
      "title": "\u0639\u0645\u0644\u0629 \u0631\u0633\u0648\u0645 \u0627\u0644\u0634\u062d\u0646",
      "enum": [
        "USD",
        "SAR",
        "YER_OLD",
        "YER_NEW",
        "AED"
      ],
      "default": "YER_NEW"
    },
    "estimated_hours": {
      "type": "string",
      "title": "\u0645\u062f\u0629 \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0645\u062a\u0648\u0642\u0639\u0629"
    },
    "estimated_time_text": {
      "type": "string",
      "title": "\u0648\u0642\u062a \u0627\u0644\u0648\u0635\u0648\u0644 \u0627\u0644\u0645\u062a\u0648\u0642\u0639 (\u0648\u0635\u0641 \u062d\u0631)"
    },
    "is_active": {
      "type": "boolean",
      "title": "\u0645\u0641\u0639\u0651\u0644\u0629",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "title": "\u0627\u0644\u062a\u0631\u062a\u064a\u0628",
      "default": 0
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "zone_name",
    "delivery_fee"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}