{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "ticket_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u062a\u0630\u0643\u0631\u0629 \u0627\u0644\u0645\u0631\u062c\u0639\u064a"
    },
    "subject": {
      "type": "string",
      "title": "\u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u062a\u0630\u0643\u0631\u0629"
    },
    "description": {
      "type": "string",
      "title": "\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0634\u0643\u0644\u0629"
    },
    "customer_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "customer_email": {
      "type": "string",
      "title": "\u0628\u0631\u064a\u062f \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "customer_phone": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "category": {
      "type": "string",
      "enum": [
        "order_issue",
        "product_issue",
        "payment_issue",
        "shipping_issue",
        "account_issue",
        "general",
        "complaint"
      ],
      "title": "\u0627\u0644\u0641\u0626\u0629"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "title": "\u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629",
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "waiting_customer",
        "resolved",
        "closed"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "default": "open"
    },
    "assigned_to": {
      "type": "string",
      "title": "\u0645\u0633\u0646\u062f\u0629 \u0625\u0644\u0649"
    },
    "order_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0637\u0644\u0628 \u0627\u0644\u0645\u0631\u062a\u0628\u0637"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sender": {
            "type": "string",
            "title": "\u0627\u0644\u0645\u0631\u0633\u0644"
          },
          "sender_role": {
            "type": "string",
            "enum": [
              "customer",
              "agent"
            ],
            "title": "\u062f\u0648\u0631 \u0627\u0644\u0645\u0631\u0633\u0644"
          },
          "message": {
            "type": "string",
            "title": "\u0646\u0635 \u0627\u0644\u0631\u0633\u0627\u0644\u0629"
          },
          "timestamp": {
            "type": "string",
            "title": "\u0627\u0644\u0648\u0642\u062a"
          }
        }
      },
      "title": "\u0631\u0633\u0627\u0626\u0644 \u0627\u0644\u062a\u0630\u0643\u0631\u0629"
    },
    "resolution": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0644 \u0627\u0644\u0645\u0642\u062f\u0645"
    },
    "resolved_at": {
      "type": "string",
      "title": "\u0648\u0642\u062a \u0627\u0644\u062d\u0644"
    },
    "first_response_at": {
      "type": "string",
      "title": "\u0623\u0648\u0644 \u0631\u062f"
    }
  },
  "required": [
    "ticket_number",
    "subject",
    "customer_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}