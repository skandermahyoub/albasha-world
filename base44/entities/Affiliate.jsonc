{
  "name": "Affiliate",
  "type": "object",
  "properties": {
    "affiliate_code": {
      "type": "string",
      "title": "\u0643\u0648\u062f \u0627\u0644\u0645\u0633\u0648\u0642"
    },
    "customer_email": {
      "type": "string",
      "title": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u0648\u0642"
    },
    "customer_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u0648\u0642"
    },
    "phone": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "suspended"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "default": "pending"
    },
    "commission_rate": {
      "type": "number",
      "title": "\u0646\u0633\u0628\u0629 \u0627\u0644\u0639\u0645\u0648\u0644\u0629 %",
      "default": 5
    },
    "total_clicks": {
      "type": "number",
      "title": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0646\u0642\u0631\u0627\u062a",
      "default": 0
    },
    "total_sales": {
      "type": "number",
      "title": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a",
      "default": 0
    },
    "total_commission": {
      "type": "number",
      "title": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0639\u0645\u0648\u0644\u0629 \u0627\u0644\u0645\u0633\u062a\u062d\u0642\u0629",
      "default": 0
    },
    "paid_commission": {
      "type": "number",
      "title": "\u0627\u0644\u0639\u0645\u0648\u0644\u0627\u062a \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0629",
      "default": 0
    },
    "referral_link": {
      "type": "string",
      "title": "\u0631\u0627\u0628\u0637 \u0627\u0644\u0625\u062d\u0627\u0644\u0629"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "affiliate_code",
    "customer_name",
    "customer_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}