{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646"
    },
    "subtitle": {
      "type": "string",
      "title": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0641\u0631\u0639\u064a"
    },
    "content": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u062d\u062a\u0648\u0649"
    },
    "image": {
      "type": "string",
      "title": "\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0642\u0627\u0644"
    },
    "category": {
      "type": "string",
      "title": "\u0627\u0644\u062a\u0635\u0646\u064a\u0641"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0627\u0644\u0648\u0633\u0648\u0645"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "views": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0634\u0627\u0647\u062f\u0627\u062a",
      "default": 0
    }
  },
  "required": [
    "title",
    "content"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}