    },
    "image": {
      "type": "string",
      "title": "\u0627\u0644\u0635\u0648\u0631\u0629"
    },
    "caption": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641"
    },
    "votes": {
      "type": "number",
      "title": "\u0627\u0644\u0623\u0635\u0648\u0627\u062a",
