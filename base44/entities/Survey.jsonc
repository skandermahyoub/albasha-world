{
  "name": "Survey",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0627\u0633\u062a\u0637\u0644\u0627\u0639"
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641"
    },
    "image": {
      "type": "string",
      "title": "\u0635\u0648\u0631\u0629 \u0627\u0644\u0627\u0633\u062a\u0637\u0644\u0627\u0639"
    },
    "questions": {
      "type": "array",
      "title": "\u0627\u0644\u0623\u0633\u0626\u0644\u0629",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "title": "\u0646\u0635 \u0627\u0644\u0633\u0624\u0627\u0644"
          },
          "type": {
            "type": "string",
            "enum": [
              "single",
              "multiple",
              "text"
            ],
            "title": "\u0627\u0644\u0646\u0648\u0639"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "\u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a"
          }
        }
      }
    },
    "show_popup": {
      "type": "boolean",
      "title": "\u0639\u0631\u0636 \u0643\u0640 Popup",
      "default": false
    },
    "popup_delay_seconds": {
      "type": "number",
      "title": "\u062a\u0623\u062e\u064a\u0631 \u0627\u0644\u0640 Popup (\u062b\u0627\u0646\u064a\u0629)",
      "default": 5
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "default": "active"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}